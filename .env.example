APP_ENV=development
DATABASE_URL=sqlite:///./village.db

# LLM routing. "fixture" needs no key and no network; switch to "anthropic"
# once ANTHROPIC_API_KEY is set (Packet 11's production-ready provider — see
# README). Model IDs live here, never in service code — this is already the
# "cheap routine model, stronger synthesis model" tiering Packet 11 asks
# for: agent decisions route through VILLAGE_AGENT_MODEL, research
# interpretation/query generation/reflection through VILLAGE_RESEARCH_MODEL,
# nightly Founder synthesis through VILLAGE_REPORT_MODEL. NEVER put a real
# key in this file; copy it to .env (already gitignored) and fill it in there.
LLM_PROVIDER=fixture
ANTHROPIC_API_KEY=
VILLAGE_AGENT_MODEL=claude-haiku-4-5
VILLAGE_RESEARCH_MODEL=claude-sonnet-5
VILLAGE_REPORT_MODEL=claude-sonnet-5
VILLAGE_RESEARCH_EFFORT=low
VILLAGE_REPORT_EFFORT=medium

# Packet 11: per-purpose live-LLM output token budgets. Ignored entirely by
# the fixture provider; only spent by a live one.
MAX_TOKENS_AGENT_DECISION=1536
MAX_TOKENS_SEARCH_QUERY=512
MAX_TOKENS_RESEARCH_SYNTHESIS=3072
MAX_TOKENS_REFLECTION=1024
MAX_TOKENS_DAILY_REPORT=4096

# Context and activation budgets.
MAX_CONVERSATION_TURNS=8
MAX_CONTEXT_MEMORIES=6
MAX_CONTEXT_RECENT_FINDINGS=5
MAX_CONTEXT_WALL_HEADLINES=5
MAX_DAILY_AGENT_ACTIVATIONS=6

# Research provider routing — independent of LLM_PROVIDER above. "fixture"
# needs no key and no network. "brave" needs BRAVE_SEARCH_API_KEY; "tavily"
# needs TAVILY_API_KEY (Packet 10's production-ready provider — see README).
# Both live adapters need `httpx` (now a real, unconditional dependency —
# see requirements.txt). NEVER put a real key in this file; copy it to
# .env (already gitignored) and fill it in there instead.
RESEARCH_PROVIDER=fixture
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Research budgets (§ "soft global research throttling").
MAX_RESEARCH_SESSIONS_PER_AGENT_PER_DAY=2
MAX_SEARCH_QUERIES_PER_SESSION=3
MAX_SOURCES_PER_QUERY=5
MAX_FOLLOW_UP_DEPTH=2
TARGET_RESEARCH_SESSIONS_PER_VILLAGE_DAY=4
MAX_EVIDENCE_TOKENS_PER_RESEARCH_SESSION=6000
# Packet 10: how many discovered sources actually get fetched into a passage,
# and the soft per-domain diversity cap consulted while choosing which ones.
MAX_FETCHED_SOURCES_PER_SESSION=3
MAX_SOURCES_PER_DOMAIN_PER_SESSION=2

# Reflection engine (Packet 9).
REFLECTION_SIGNIFICANCE_THRESHOLD=100.0
MAX_CONTEXT_REFLECTIONS=3

# Daily Founder report token/context budgets (Packet 9).
MAX_REPORT_FINDINGS=8
MAX_REPORT_WALL_POSTS=6
MAX_REPORT_RABBIT_HOLES=6
MAX_REPORT_CONVERSATIONS=6
MAX_REPORT_MEMORY_EVENTS=8
MAX_REPORT_REFLECTIONS=6
MAX_REPORT_BELIEF_CHANGES=6
