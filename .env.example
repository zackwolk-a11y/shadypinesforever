APP_ENV=development
DATABASE_URL=sqlite:///./village.db

# LLM routing. "fixture" needs no key and no network; switch to "anthropic"
# once ANTHROPIC_API_KEY is set. Model IDs live here, never in service code.
LLM_PROVIDER=fixture
ANTHROPIC_API_KEY=
VILLAGE_AGENT_MODEL=claude-haiku-4-5
VILLAGE_RESEARCH_MODEL=claude-sonnet-5
VILLAGE_REPORT_MODEL=claude-sonnet-5
VILLAGE_RESEARCH_EFFORT=low
VILLAGE_REPORT_EFFORT=medium

# Context and activation budgets.
MAX_CONVERSATION_TURNS=8
MAX_CONTEXT_MEMORIES=6
MAX_CONTEXT_RECENT_FINDINGS=5
MAX_CONTEXT_WALL_HEADLINES=5
MAX_DAILY_AGENT_ACTIVATIONS=6

# Research provider routing — independent of LLM_PROVIDER above. "fixture"
# needs no key and no network. "brave" needs BRAVE_SEARCH_API_KEY; "tavily"
# needs TAVILY_API_KEY. Both live adapters need `httpx` installed and are
# unverified in this repository (no key/network available while building them)
# — treat the first live call as a smoke test.
RESEARCH_PROVIDER=fixture
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Research budgets (§ "soft global research throttling").
MAX_RESEARCH_SESSIONS_PER_AGENT_PER_DAY=2
MAX_SEARCH_QUERIES_PER_SESSION=3
MAX_SOURCES_PER_QUERY=5
MAX_FOLLOW_UP_DEPTH=2
TARGET_RESEARCH_SESSIONS_PER_VILLAGE_DAY=4
MAX_EVIDENCE_TOKENS_PER_RESEARCH_SESSION=6000
